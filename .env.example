NVIDIA_API_KEY=nvapi-your-key-here
# Optional: a separate key for the second model, Nemotron 3 Super. Leave unset to use NVIDIA_API_KEY.
NEMOTRON_API_KEY=nvapi-your-nemotron-key-here
# Optional; these are the defaults.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Default AI model: llama-3.2-11b or nemotron-3-super (see GET /models); users can pick per upload.
# LLM_MODEL=llama-3.2-11b
