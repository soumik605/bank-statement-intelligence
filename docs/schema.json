{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AISummary": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source": {
          "description": "template when the LLM failed or used numbers that aren't in the computed figures",
          "enum": [
            "llm",
            "template"
          ],
          "title": "Source",
          "type": "string"
        },
        "unsupported_numbers": {
          "description": "Numbers the LLM invented on its last attempt, if any",
          "items": {
            "type": "string"
          },
          "title": "Unsupported Numbers",
          "type": "array"
        }
      },
      "required": [
        "text",
        "source"
      ],
      "title": "AISummary",
      "type": "object"
    },
    "Analytics": {
      "additionalProperties": false,
      "properties": {
        "transaction_count": {
          "minimum": 0,
          "title": "Transaction Count",
          "type": "integer"
        },
        "total_credits": {
          "description": "Sum of all credit amounts",
          "minimum": 0,
          "title": "Total Credits",
          "type": "number"
        },
        "total_debits": {
          "description": "Sum of all debit amounts",
          "minimum": 0,
          "title": "Total Debits",
          "type": "number"
        },
        "net_flow": {
          "description": "total_credits - total_debits; negative means more went out than came in",
          "title": "Net Flow",
          "type": "number"
        },
        "total_spending": {
          "description": "Debits except Transfer; uncategorized debits count as Other. Refunds are credits, so they are not netted against spending",
          "minimum": 0,
          "title": "Total Spending",
          "type": "number"
        },
        "spending_by_category": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "total_spending split by category",
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "title": "Spending By Category",
          "type": "object"
        },
        "top_spending_categories": {
          "description": "Highest spending first",
          "items": {
            "$ref": "#/$defs/Category"
          },
          "maxItems": 3,
          "title": "Top Spending Categories",
          "type": "array"
        }
      },
      "required": [
        "transaction_count",
        "total_credits",
        "total_debits",
        "net_flow",
        "total_spending",
        "spending_by_category",
        "top_spending_categories"
      ],
      "title": "Analytics",
      "type": "object"
    },
    "AnalyzeResponse": {
      "description": "Everything POST /analyze returns for one statement.",
      "properties": {
        "analysis_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID in the local history database; null if saving failed",
          "title": "Analysis Id"
        },
        "analyzed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the analysis ran, UTC",
          "title": "Analyzed At"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "account": {
          "$ref": "#/$defs/StatementInfo"
        },
        "transactions": {
          "items": {
            "$ref": "#/$defs/Transaction"
          },
          "title": "Transactions",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/Analytics"
        },
        "unusual": {
          "description": "The transactions with is_unusual set, in statement order",
          "items": {
            "$ref": "#/$defs/Transaction"
          },
          "title": "Unusual",
          "type": "array"
        },
        "ai_summary": {
          "$ref": "#/$defs/AISummary"
        },
        "skipped_rows": {
          "description": "Table rows that weren't transactions: totals, opening balance, footers",
          "items": {
            "$ref": "#/$defs/SkippedRowOut"
          },
          "title": "Skipped Rows",
          "type": "array"
        }
      },
      "required": [
        "source_file",
        "account",
        "transactions",
        "summary",
        "unusual",
        "ai_summary"
      ],
      "title": "AnalyzeResponse",
      "type": "object"
    },
    "Category": {
      "enum": [
        "Salary",
        "Income",
        "Refund",
        "Rent",
        "Utilities",
        "Food",
        "Travel",
        "Shopping",
        "Transfer",
        "Cash",
        "Other"
      ],
      "title": "Category",
      "type": "string"
    },
    "SkippedRowOut": {
      "properties": {
        "row": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The row as extracted, column name to text",
          "title": "Row",
          "type": "object"
        },
        "reason": {
          "description": "Why it is not a transaction, e.g. \"no date\" for a totals row",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "row",
        "reason"
      ],
      "title": "SkippedRowOut",
      "type": "object"
    },
    "StatementInfo": {
      "additionalProperties": false,
      "properties": {
        "bank_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bank Name"
        },
        "account_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Masked, last 4 digits only, e.g. XXXX1234",
          "title": "Account Number"
        },
        "holder_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holder Name"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        }
      },
      "required": [
        "period_start",
        "period_end"
      ],
      "title": "StatementInfo",
      "type": "object"
    },
    "Transaction": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Transaction date, ISO 8601 (YYYY-MM-DD)",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "description": {
          "description": "Narration as printed on the statement",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "amount": {
          "description": "Always positive, rounded to 2 decimals; direction is in `type`",
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "type": {
          "description": "credit = money in, debit = money out",
          "enum": [
            "credit",
            "debit"
          ],
          "title": "Type",
          "type": "string"
        },
        "balance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Running balance after this transaction; signed",
          "title": "Balance"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None until categorized"
        },
        "category_source": {
          "anyOf": [
            {
              "enum": [
                "rule",
                "llm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What assigned `category`; set if and only if `category` is set",
          "title": "Category Source"
        },
        "is_unusual": {
          "default": false,
          "title": "Is Unusual",
          "type": "boolean"
        },
        "unusual_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when is_unusual is true, else null",
          "title": "Unusual Reason"
        }
      },
      "required": [
        "date",
        "description",
        "amount",
        "type"
      ],
      "title": "Transaction",
      "type": "object"
    }
  },
  "title": "Bank statement schema"
}
