{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Category": {
      "enum": [
        "income",
        "transfer",
        "bills",
        "food",
        "shopping",
        "transport",
        "cash",
        "other"
      ],
      "title": "Category",
      "type": "string"
    }
  },
  "properties": {
    "date": {
      "description": "Transaction date, ISO 8601 (YYYY-MM-DD)",
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "amount": {
      "description": "Always positive, rounded to 2 decimals; see direction",
      "exclusiveMinimum": 0,
      "title": "Amount",
      "type": "number"
    },
    "direction": {
      "description": "credit = money in, debit = money out",
      "enum": [
        "debit",
        "credit"
      ],
      "title": "Direction",
      "type": "string"
    },
    "balance": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Running balance after this transaction; signed",
      "title": "Balance"
    },
    "category": {
      "$ref": "#/$defs/Category",
      "default": "other",
      "description": "One of the 8 fixed categories"
    },
    "reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference"
    },
    "page": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Source PDF page",
      "title": "Page"
    }
  },
  "required": [
    "date",
    "description",
    "amount",
    "direction"
  ],
  "title": "Transaction",
  "type": "object"
}
